{
  "pluginAlias": "FakeHomeKey",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Fake lock with Apple Home Key. It has no NFC reader: it only makes the key appear in Wallet.",
  "schema": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Home Key Lock"
      },
      "finish": {
        "title": "Key color in Wallet",
        "type": "string",
        "default": "tan",
        "oneOf": [
          { "title": "Tan (beige)", "enum": ["tan"] },
          { "title": "Gold", "enum": ["gold"] },
          { "title": "Silver", "enum": ["silver"] },
          { "title": "Black", "enum": ["black"] }
        ]
      },
      "autoLockSeconds": {
        "title": "Auto re-lock (seconds, 0 = never, max 86400)",
        "type": "integer",
        "default": 5,
        "minimum": 0,
        "maximum": 86400
      },
      "serialNumber": {
        "title": "Serial number",
        "type": "string",
        "default": "FHK-0001"
      },
      "resetState": {
        "title": "Clear reader key and stored credentials",
        "description": "Enable for a single restart when you need to pair from scratch, then disable it again.",
        "type": "boolean",
        "default": false
      }
    }
  }
}
